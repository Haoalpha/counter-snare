# Cấu hình LLM (GreenNode MaaS – OpenAI-compatible). KHÔNG commit file .env thật.
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_API_KEY=
EMBED_MODEL=baai/bge-m3
# Định tuyến model theo tác vụ + giới hạn RPM nằm trong app/llm.py (theo quy định BTC).
# Ghi đè hạn mức nếu BTC thay đổi, ví dụ: LLM_RPM=qwen/qwen3.8-flash=10,google/gemma-4-31b-it=15
LLM_RPM=
LLM_TIMEOUT=40
LLM_MAX_WAIT=25

# AgentBase Memory (tạo bằng: python deploy/agentbase.py memory). Để trống thì dùng bộ nhớ cục bộ.
MEMORY_ID=
MEMORY_STRATEGY_ID=

# KHÔNG đặt GREENNODE_CLIENT_ID / GREENNODE_CLIENT_SECRET / GREENNODE_AGENT_IDENTITY / GREENNODE_ENDPOINT_URL ở đây:
# AgentBase Runtime tự inject khi chạy trên nền tảng.
